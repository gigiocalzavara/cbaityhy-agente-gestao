# Web app
APP_URL=http://localhost:3000

# e-SUS PEC runtime
# Host/database/user/password/SSL are configured per municipality inside the application.
PEC_PG_POOL_MAX=5
PEC_PG_STATEMENT_TIMEOUT_MS=8000

# 32-byte key (64 hex chars or base64) used to encrypt PEC PostgreSQL passwords.
# Generate once and keep it stable across deployments. Example: openssl rand -hex 32
APS_AGENT_DB_CREDENTIALS_KEY=

# CBAItyhy OPERATIONAL Supabase
# Auth, users, municipalities, RBAC and encrypted PEC connection metadata.
# Apply supabase/operational migrations in THIS database.
CBAITYHY_OPERATIONAL_SUPABASE_URL=
CBAITYHY_OPERATIONAL_SUPABASE_SECRET_KEY=

# CBAItyhy AI Supabase
# Separate production AI/vector database used for RAG only.
CBAITYHY_AI_SUPABASE_URL=
CBAITYHY_AI_SUPABASE_SECRET_KEY=
CBAITYHY_ORGANIZATION_ID=

# LLM / embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Security
DEFAULT_RESULT_LIMIT=15
LOG_LEVEL=info
