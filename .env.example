# Web app
APP_URL=http://localhost:3000

# e-SUS PEC PostgreSQL — dedicated READ ONLY account
PEC_PG_HOST=
PEC_PG_PORT=5432
PEC_PG_DATABASE=
PEC_PG_USER=
PEC_PG_PASSWORD=
PEC_PG_SSL=true
PEC_PG_POOL_MAX=5
PEC_PG_STATEMENT_TIMEOUT_MS=8000

# Shared CBAItyhy AI Supabase
# Same project/database used by the CBAItyhy module in Azurra Leads / Suporte SUS.
# The secret key is server-only and must never use NEXT_PUBLIC_.
CBAITYHY_AI_SUPABASE_URL=
CBAITYHY_AI_SUPABASE_SECRET_KEY=
CBAITYHY_ORGANIZATION_ID=

# LLM / embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Security
DEFAULT_RESULT_LIMIT=15
LOG_LEVEL=info
