# n8n / runtime
N8N_WEBHOOK_BASE_URL=

# e-SUS PEC PostgreSQL (use READ ONLY account)
PEC_PG_HOST=
PEC_PG_PORT=5432
PEC_PG_DATABASE=
PEC_PG_USER=
PEC_PG_PASSWORD=
PEC_PG_SSL=true
PEC_PG_STATEMENT_TIMEOUT_MS=8000

# Evolution API
EVOLUTION_API_BASE_URL=
EVOLUTION_API_INSTANCE=
EVOLUTION_API_KEY=

# Supabase RAG
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VECTOR_TABLE=knowledge_documents
SUPABASE_MATCH_FUNCTION=match_documents

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# QuickChart
QUICKCHART_BASE_URL=https://quickchart.io/chart

# Security / authorization
DEFAULT_RESULT_LIMIT=15
ENABLE_NOMINAL_RESULTS=false
ALLOWED_MUNICIPALITY_CODES=
LOG_LEVEL=info
